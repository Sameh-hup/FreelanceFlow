{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\ProjectModels;Database=FreelanceFlowDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "ProjectHealthRules": {
    "CriticalOverdueTasksCount": 3,
    "CriticalDaysRemaining": 3,
    "CriticalProgressThreshold": 50,
    "AttentionRequiredDaysRemaining": 7,
    "AttentionRequiredProgressThreshold": 70
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
