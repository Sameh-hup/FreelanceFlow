@model App.Mvc.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-4 fw-bold text-dark mb-1">System Administration</h1>
        <p class="page-subtitle text-secondary-ff text-sm mb-0">Platform overview, security, and global user management</p>
    </div>
    <div>
        <a asp-action="Users" class="btn btn-sm btn-primary-ff">
            <i class="bi bi-people-fill me-1"></i> Manage Users
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card" onclick="window.location='@Url.Action("Users", "Admin")'" style="cursor: pointer;">
            <div>
                <span class="stat-title text-xs fw-semibold text-uppercase text-secondary-ff">Total Users</span>
                <div class="stat-value fs-2 fw-bold text-dark mt-1">@Model.TotalUsers</div>
                <div class="stat-subtitle text-xs text-muted-ff mt-1">Across all roles</div>
            </div>
            <div class="stat-icon-wrapper" style="background-color: var(--color-primary-light); color: var(--color-primary);">
                <i class="bi bi-people"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <span class="stat-title text-xs fw-semibold text-uppercase text-secondary-ff">Freelancers</span>
                <div class="stat-value fs-2 fw-bold text-dark mt-1">@Model.TotalFreelancers</div>
                <div class="stat-subtitle text-xs text-muted-ff mt-1">Registered providers</div>
            </div>
            <div class="stat-icon-wrapper" style="background-color: var(--color-info-bg); color: var(--color-info);">
                <i class="bi bi-briefcase"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <span class="stat-title text-xs fw-semibold text-uppercase text-secondary-ff">Clients</span>
                <div class="stat-value fs-2 fw-bold text-dark mt-1">@Model.TotalClients</div>
                <div class="stat-subtitle text-xs text-muted-ff mt-1">Portal accounts</div>
            </div>
            <div class="stat-icon-wrapper" style="background-color: var(--color-success-bg); color: var(--color-success);">
                <i class="bi bi-person-check"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card">
            <div>
                <span class="stat-title text-xs fw-semibold text-uppercase text-secondary-ff">Active Status</span>
                <div class="stat-value fs-2 fw-bold text-success mt-1">@Model.ActiveUsers</div>
                <div class="stat-subtitle text-xs text-muted-ff mt-1">Unlocked accounts</div>
            </div>
            <div class="stat-icon-wrapper" style="background-color: var(--color-success-bg); color: var(--color-success);">
                <i class="bi bi-shield-check"></i>
            </div>
        </div>
    </div>
</div>

<div class="ff-card p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="fs-6 fw-semibold text-dark mb-0">Recently Registered Users</h2>
        <a asp-action="Users" class="text-xs fw-medium text-primary">View all users</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-sm">
            <thead class="table-light text-xs text-uppercase text-secondary-ff">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.RecentUsers)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold text-dark">@user.FullName</div>
                            <div class="text-xs text-muted-ff">@user.Email</div>
                        </td>
                        <td>
                            @if (user.Role == UserRole.Admin)
                            {
                                <span class="badge-ff badge-warning badge-sm">Admin</span>
                            }
                            else if (user.Role == UserRole.Client)
                            {
                                <span class="badge-ff badge-success badge-sm">Client</span>
                            }
                            else
                            {
                                <span class="badge-ff badge-indigo badge-sm">Freelancer</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge-ff badge-success badge-sm"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge-ff badge-danger badge-sm"><i class="bi bi-slash-circle-fill me-1"></i> Blocked</span>
                            }
                        </td>
                        <td>
                            <span class="text-secondary-ff text-xs">@user.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
