@model List<App.Mvc.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-4 fw-bold text-dark mb-1">User Management</h1>
        <p class="page-subtitle text-secondary-ff text-sm mb-0">Control account status, inspect security states and manage user roles</p>
    </div>
</div>

<div class="ff-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-sm">
            <thead class="table-light text-xs text-uppercase text-secondary-ff">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-ff avatar-sm @(user.Role == UserRole.Admin ? "avatar-dark" : "avatar-indigo")">
                                    @user.FullName.Substring(0, Math.Min(2, user.FullName.Length)).ToUpper()
                                </div>
                                <span class="fw-semibold text-dark">@user.FullName</span>
                            </div>
                        </td>
                        <td>
                            <span class="text-secondary-ff">@user.Email</span>
                        </td>
                        <td>
                            @if (user.Role == UserRole.Admin)
                            {
                                <span class="badge-ff badge-warning badge-sm">Admin</span>
                            }
                            else if (user.Role == UserRole.Client)
                            {
                                <span class="badge-ff badge-success badge-sm">Client</span>
                            }
                            else
                            {
                                <span class="badge-ff badge-indigo badge-sm">Freelancer</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge-ff badge-success badge-sm"><i class="bi bi-check-circle-fill me-1"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge-ff badge-danger badge-sm"><i class="bi bi-slash-circle-fill me-1"></i> Blocked</span>
                            }
                        </td>
                        <td>
                            <span class="text-secondary-ff text-xs">@user.CreatedAtUtc.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-secondary-ff text-danger" : "btn-primary-ff") text-xs py-1 px-2">
                                    @if (user.IsActive)
                                    {
                                        <i class="bi bi-person-x-fill me-1"></i>
                                        <span>Deactivate</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-check-fill me-1"></i>
                                        <span>Activate</span>
                                    }
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
