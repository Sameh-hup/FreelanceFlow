@model App.Mvc.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Freelancer Account";
}

<div class="min-vh-100 d-flex flex-column justify-content-center py-5 bg-light">
    <div class="container" style="max-width: 480px;">
        <!-- Branding -->
        <div class="text-center mb-4">
            <div class="sidebar-brand-logo mx-auto mb-2" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-stack"></i>
            </div>
            <h1 class="h1 fs-3 fw-bold mb-1 text-dark">FreelanceFlow</h1>
            <p class="text-secondary-ff text-sm">Join the platform to manage your freelance business</p>
        </div>

        <!-- Card -->
        <div class="ff-card p-4 p-md-5 mb-4 shadow-sm bg-white rounded-3">
            <h2 class="h2 fs-5 mb-1 text-dark fw-semibold">Create your account</h2>
            <p class="text-xs text-muted-ff mb-3">Public registration is available exclusively for Freelancers</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 text-sm mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label text-sm fw-medium text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" class="form-control border-start-0" placeholder="e.g. John Doe" required autofocus />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger text-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-sm fw-medium text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0" placeholder="john@example.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger text-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-sm fw-medium text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="At least 6 characters" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger text-xs"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-sm fw-medium text-dark"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0" placeholder="Confirm your password" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger text-xs"></span>
                </div>

                <button type="submit" class="btn btn-primary-ff w-100 py-2">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Register Freelancer Account</span>
                </button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <span class="text-sm text-secondary-ff">Already have an account? </span>
                <a asp-action="Login" class="text-sm fw-semibold text-primary">Sign in</a>
            </div>
        </div>
    </div>
</div>
