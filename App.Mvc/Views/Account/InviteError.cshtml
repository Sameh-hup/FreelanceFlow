@{
    ViewData["Title"] = "Invitation Error";
    Layout = "_Layout";
}
<div class="container py-5 text-center">
    <div class="ff-card p-5 mx-auto" style="max-width: 500px;">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-1 mb-3 d-block"></i>
        <h2 class="fs-4 fw-bold text-dark mb-2">Invalid Invitation</h2>
        <p class="text-secondary-ff text-sm mb-4">@(ViewBag.ErrorMessage ?? "This invitation link is invalid or has expired.")</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-ff">Go to Homepage</a>
    </div>
</div>