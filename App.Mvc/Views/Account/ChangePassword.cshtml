@model App.Mvc.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="ff-card p-4 p-md-5 bg-white shadow-sm rounded-3">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div class="stat-icon-wrapper bg-warning-subtle text-warning" style="width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-key-fill"></i>
                </div>
                <div>
                    <h2 class="h2 fs-5 mb-0 text-dark fw-semibold">Change Password</h2>
                    <span class="text-xs text-muted-ff">Update your security credentials</span>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 text-sm mb-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="OldPassword" class="form-label text-sm fw-medium text-dark"></label>
                    <input asp-for="OldPassword" type="password" class="form-control" required autofocus />
                    <span asp-validation-for="OldPassword" class="text-danger text-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label text-sm fw-medium text-dark"></label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 6 characters" required />
                    <span asp-validation-for="NewPassword" class="text-danger text-xs"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-sm fw-medium text-dark"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger text-xs"></span>
                </div>

                <button type="submit" class="btn btn-primary-ff w-100 py-2">
                    <i class="bi bi-check2-circle"></i>
                    <span>Update Password</span>
                </button>
            </form>
        </div>
    </div>
</div>
