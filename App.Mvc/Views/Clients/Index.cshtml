@model List<App.Mvc.ViewModels.ClientViewModel>
@{
    ViewData["Title"] = "Clients";
}

<!-- Page Header -->
<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-4 fw-bold text-dark mb-1">Clients</h1>
        <p class="page-subtitle text-secondary-ff text-sm mb-0">Manage your client organizations and portal invitations</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-sm btn-primary-ff">
            <i class="bi bi-person-plus-fill me-1"></i> Add Client
        </a>
    </div>
</div>

@if (TempData["InviteLink"] != null)
{
    <div class="alert alert-info alert-dismissible fade show p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between" role="alert">
        <div>
            <div class="fw-semibold text-sm mb-1"><i class="bi bi-link-45deg me-1"></i> Client Invitation Link Created:</div>
            <code class="user-select-all text-xs bg-white p-1 rounded border">@TempData["InviteLink"]</code>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search Bar & Filters -->
<div class="ff-card p-3 mb-4">
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 text-sm" placeholder="Search clients by company name..." />
        </div>
        <button type="submit" class="btn btn-sm btn-secondary-ff">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-ghost-ff text-xs">Clear</a>
        }
    </form>
</div>

<!-- Clients Table -->
<div class="ff-card overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="empty-state text-center py-5">
            <div class="empty-state-icon mx-auto mb-2 text-muted-ff fs-1"><i class="bi bi-people"></i></div>
            <div class="empty-state-title fs-5 fw-semibold text-dark">No clients found</div>
            <p class="empty-state-description text-sm text-muted-ff mb-3" style="max-width: 400px; margin: 0 auto;">
                @(string.IsNullOrEmpty(ViewBag.Search) ? "Click 'Add Client' to create your first client and begin tracking projects." : "No clients matched your search term.")
            </p>
            @if (string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Create" class="btn btn-primary-ff"><i class="bi bi-plus-lg me-1"></i> Add Client</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-sm">
                <thead class="table-light text-xs text-uppercase text-secondary-ff">
                    <tr>
                        <th>Company Name</th>
                        <th>Contact Phone</th>
                        <th>Address</th>
                        <th>Projects</th>
                        <th>Portal Access</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@client.ID" class="fw-semibold text-dark">@client.CompanyName</a>
                            </td>
                            <td>
                                <span class="text-secondary-ff">@client.Phone</span>
                            </td>
                            <td>
                                <span class="text-secondary-ff text-truncate d-inline-block" style="max-width: 200px;">@client.Address</span>
                            </td>
                            <td>
                                <span class="badge-ff badge-neutral badge-sm">@client.ProjectCount Projects</span>
                            </td>
                            <td>
                                @if (client.HasPortalAccess)
                                {
                                    <span class="badge-ff badge-success badge-sm" title="@client.PortalUserEmail">
                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-ghost-ff text-xs text-primary p-1" onclick="openInviteModal(@client.ID, '@client.CompanyName')">
                                        <i class="bi bi-send-fill me-1"></i> Invite
                                    </button>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@client.ID" class="btn btn-sm btn-ghost-ff p-1 text-secondary-ff" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@client.ID" class="btn btn-sm btn-ghost-ff p-1 text-secondary-ff" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@client.ID" method="post" class="d-inline" data-ff-confirm="Delete @client.CompanyName?" data-ff-message="This client will be moved to trash." data-ff-ok="Move to trash">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-ghost-ff p-1 text-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Invite Client Modal -->
<div class="modal fade" id="inviteModal" tabindex="-1" aria-labelledby="inviteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Invite" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="clientId" id="modalClientId" />
                <div class="modal-header">
                    <h5 class="modal-title fs-6 fw-semibold" id="inviteModalLabel">Invite Client to Portal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-xs text-secondary-ff mb-3">
                        Generate a secure invitation token for <strong id="modalClientName"></strong>. The client will be able to set up their password and log into their project dashboard.
                    </p>
                    <div class="mb-3">
                        <label class="form-label text-xs fw-medium text-dark">Client Email Address</label>
                        <input type="email" name="clientEmail" class="form-control" placeholder="client@company.com" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary-ff" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary-ff"><i class="bi bi-send-fill me-1"></i> Send Invitation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openInviteModal(clientId, clientName) {
            document.getElementById('modalClientId').value = clientId;
            document.getElementById('modalClientName').textContent = clientName;
            const modal = new bootstrap.Modal(document.getElementById('inviteModal'));
            modal.show();
        }
    </script>
}
