@model App.DAL.Entities.Client
@inject App.BLL.Interfaces.Services.IProjectService ProjectService
@{
    ViewData["Title"] = Model.CompanyName;
}

<div class="mb-4">
    <a asp-action="Index" class="text-xs text-secondary-ff text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Back to Clients
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mt-2">
        <div>
            <h1 class="page-title fs-4 fw-bold text-dark mb-1">@Model.CompanyName</h1>
            <p class="page-subtitle text-secondary-ff text-sm mb-0">Client Overview and Active Engagements</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-sm btn-secondary-ff">
                <i class="bi bi-pencil me-1"></i> Edit Profile
            </a>
            <a asp-controller="Projects" asp-action="Create" asp-route-clientId="@Model.ID" class="btn btn-sm btn-primary-ff">
                <i class="bi bi-plus-lg me-1"></i> New Project
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Client Info Card -->
    <div class="col-12 col-lg-4">
        <div class="ff-card p-4">
            <h2 class="fs-6 fw-semibold text-dark mb-3">Contact Details</h2>
            <div class="d-flex flex-column gap-3 text-sm">
                <div>
                    <span class="text-xs text-muted-ff text-uppercase fw-semibold d-block">Phone</span>
                    <span class="text-dark fw-medium">@Model.Phone</span>
                </div>
                <div>
                    <span class="text-xs text-muted-ff text-uppercase fw-semibold d-block">Address</span>
                    <span class="text-dark">@Model.Address</span>
                </div>
                <div>
                    <span class="text-xs text-muted-ff text-uppercase fw-semibold d-block">Portal User</span>
                    @if (Model.PortalUser != null)
                    {
                        <span class="badge-ff badge-success badge-sm mt-1">
                            <i class="bi bi-shield-check me-1"></i> @Model.PortalUser.Email
                        </span>
                    }
                    else
                    {
                        <span class="badge-ff badge-neutral badge-sm mt-1">No portal user registered</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="pt-2 border-top">
                        <span class="text-xs text-muted-ff text-uppercase fw-semibold d-block mb-1">Notes</span>
                        <p class="text-xs text-secondary-ff mb-0">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Associated Projects -->
    <div class="col-12 col-lg-8">
        <div class="ff-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="fs-6 fw-semibold text-dark mb-0">Client Projects (@Model.Projects.Count)</h2>
                <a asp-controller="Projects" asp-action="Create" asp-route-clientId="@Model.ID" class="btn btn-sm btn-ghost-ff text-xs text-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add Project
                </a>
            </div>

            @if (Model.Projects.Count == 0)
            {
                <div class="empty-state text-center py-4">
                    <div class="empty-state-icon mx-auto mb-2 text-muted-ff fs-2"><i class="bi bi-kanban"></i></div>
                    <div class="empty-state-title fs-6 fw-semibold text-dark">No projects yet</div>
                    <p class="empty-state-description text-xs text-muted-ff mb-3">Create the first project for this client to get started.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light text-xs text-uppercase text-secondary-ff">
                            <tr>
                                <th>Project Name</th>
                                <th>Deadline</th>
                                <th>Progress</th>
                                <th>Status</th>
                                <th class="text-end">View</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proj in Model.Projects)
                            {
                                var progress = ProjectService.CalculateProgress(proj);
                                <tr>
                                    <td>
                                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@proj.ID" class="fw-semibold text-dark">@proj.Name</a>
                                        <div class="text-xs text-muted-ff">Budget: @proj.Currency @proj.Budget.ToString("N2")</div>
                                    </td>
                                    <td>
                                        <span class="text-secondary-ff text-xs">@proj.Deadline.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td style="min-width: 120px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @(progress)%"></div>
                                            </div>
                                            <span class="text-xs text-muted-ff">@(progress)%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-ff badge-indigo badge-sm">@proj.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Projects" asp-action="Details" asp-route-id="@proj.ID" class="btn btn-sm btn-ghost-ff p-1">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
