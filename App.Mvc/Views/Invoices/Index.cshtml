@model List<App.Mvc.ViewModels.InvoiceViewModel>
@{
    ViewData["Title"] = "Invoices";
}

<!-- Page Header -->
<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-4 fw-bold text-dark mb-1">Invoices</h1>
        <p class="page-subtitle text-secondary-ff text-sm mb-0">Manage billing, outstanding balances, and recorded payments</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-sm btn-primary-ff">
            <i class="bi bi-receipt me-1"></i> Create Invoice
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="ff-card p-3 mb-4">
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 text-sm" placeholder="Search invoices by project or client..." />
        </div>
        <button type="submit" class="btn btn-sm btn-secondary-ff">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-ghost-ff text-xs">Clear</a>
        }
    </form>
</div>

<!-- Invoices Table -->
<div class="ff-card overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="empty-state text-center py-5">
            <div class="empty-state-icon mx-auto mb-2 text-muted-ff fs-1"><i class="bi bi-receipt"></i></div>
            <div class="empty-state-title fs-5 fw-semibold text-dark">No invoices found</div>
            <p class="empty-state-description text-sm text-muted-ff mb-3" style="max-width: 400px; margin: 0 auto;">
                @(string.IsNullOrEmpty(ViewBag.Search) ? "Create your first invoice to start billing your clients." : "No invoices match your search.")
            </p>
            @if (string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Create" class="btn btn-primary-ff"><i class="bi bi-plus-lg me-1"></i> Create Invoice</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-sm">
                <thead class="table-light text-xs text-uppercase text-secondary-ff">
                    <tr>
                        <th>Invoice #</th>
                        <th>Project & Client</th>
                        <th>Amount</th>
                        <th>Remaining</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@inv.ID" class="fw-semibold text-dark">INV-@inv.ID.ToString("D4")</a>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@inv.ProjectName</div>
                                <div class="text-xs text-muted-ff">@inv.ClientName</div>
                            </td>
                            <td>
                                <span class="fw-medium text-dark">@inv.Currency @inv.Amount.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="@(inv.RemainingBalance > 0 ? "text-danger fw-semibold" : "text-success fw-medium")">
                                    @inv.Currency @inv.RemainingBalance.ToString("N2")
                                </span>
                            </td>
                            <td>
                                <span class="text-secondary-ff text-xs">@inv.DueDate.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td>
                                @if (inv.Status == InvoiceStatus.Paid)
                                {
                                    <span class="badge-ff badge-success badge-sm"><i class="bi bi-check-circle-fill me-1"></i> Paid</span>
                                }
                                else if (inv.Status == InvoiceStatus.Overdue)
                                {
                                    <span class="badge-ff badge-danger badge-sm"><i class="bi bi-exclamation-octagon-fill me-1"></i> Overdue</span>
                                }
                                else if (inv.Status == InvoiceStatus.PartiallyPaid)
                                {
                                    <span class="badge-ff badge-info badge-sm"><i class="bi bi-pie-chart-fill me-1"></i> Partial</span>
                                }
                                else
                                {
                                    <span class="badge-ff badge-neutral badge-sm">Unpaid</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@inv.ID" class="btn btn-sm btn-ghost-ff p-1 text-secondary-ff" title="View details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@inv.ID" method="post" class="d-inline" data-ff-confirm="Delete INV-@inv.ID.ToString("D4")?" data-ff-message="This invoice will be deleted. This action cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-ghost-ff p-1 text-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
