@model List<App.Mvc.ViewModels.ProjectViewModel>
@{
    ViewData["Title"] = "Projects";
}

<!-- Page Header -->
<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="page-title fs-4 fw-bold text-dark mb-1">Projects</h1>
        <p class="page-subtitle text-secondary-ff text-sm mb-0">Track deliverables, milestones, budgets and overall health</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-sm btn-primary-ff">
            <i class="bi bi-plus-lg me-1"></i> New Project
        </a>
    </div>
</div>

<!-- Search Bar -->
<div class="ff-card p-3 mb-4">
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 text-sm" placeholder="Search projects by name..." />
        </div>
        <button type="submit" class="btn btn-sm btn-secondary-ff">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <a asp-action="Index" class="btn btn-sm btn-ghost-ff text-xs">Clear</a>
        }
    </form>
</div>

<!-- Projects Table -->
<div class="ff-card overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="empty-state text-center py-5">
            <div class="empty-state-icon mx-auto mb-2 text-muted-ff fs-1"><i class="bi bi-kanban"></i></div>
            <div class="empty-state-title fs-5 fw-semibold text-dark">No projects found</div>
            <p class="empty-state-description text-sm text-muted-ff mb-3" style="max-width: 400px; margin: 0 auto;">
                @(string.IsNullOrEmpty(ViewBag.Search) ? "Create your first project to break it down into milestones and tasks." : "No projects match your search.")
            </p>
            @if (string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Create" class="btn btn-primary-ff"><i class="bi bi-plus-lg me-1"></i> New Project</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-sm">
                <thead class="table-light text-xs text-uppercase text-secondary-ff">
                    <tr>
                        <th>Project Name</th>
                        <th>Client</th>
                        <th>Budget</th>
                        <th>Deadline</th>
                        <th>Progress</th>
                        <th>Health</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proj in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@proj.ID" class="fw-semibold text-dark">@proj.Name</a>
                            </td>
                            <td>
                                <span class="text-secondary-ff">@proj.ClientName</span>
                            </td>
                            <td>
                                <span class="text-dark fw-medium">@proj.Currency @proj.Budget.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="text-secondary-ff text-xs">@proj.Deadline.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td style="min-width: 120px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(proj.Progress)%" aria-valuenow="@proj.Progress" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="text-xs text-muted-ff">@(proj.Progress)%</span>
                                </div>
                            </td>
                            <td>
                                @if (proj.Health == ProjectHealth.Critical)
                                {
                                    <span class="badge-ff badge-danger badge-sm"><i class="bi bi-exclamation-triangle-fill me-1"></i> Critical</span>
                                }
                                else if (proj.Health == ProjectHealth.AttentionRequired)
                                {
                                    <span class="badge-ff badge-warning badge-sm"><i class="bi bi-exclamation-circle me-1"></i> Attention</span>
                                }
                                else
                                {
                                    <span class="badge-ff badge-success badge-sm"><i class="bi bi-check-circle me-1"></i> Healthy</span>
                                }
                            </td>
                            <td>
                                @if (proj.Status == ProjectStatus.InProgress)
                                {
                                    <span class="badge-ff badge-indigo badge-sm">InProgress</span>
                                }
                                else if (proj.Status == ProjectStatus.Completed)
                                {
                                    <span class="badge-ff badge-success badge-sm">Completed</span>
                                }
                                else if (proj.Status == ProjectStatus.OnHold)
                                {
                                    <span class="badge-ff badge-warning badge-sm">OnHold</span>
                                }
                                else if (proj.Status == ProjectStatus.Cancelled)
                                {
                                    <span class="badge-ff badge-danger badge-sm">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge-ff badge-neutral badge-sm">NotStarted</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@proj.ID" class="btn btn-sm btn-ghost-ff p-1 text-secondary-ff" title="View details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@proj.ID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @proj.Name? (Will fail if invoices exist)');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-ghost-ff p-1 text-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
