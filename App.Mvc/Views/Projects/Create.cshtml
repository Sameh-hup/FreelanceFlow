@model App.Mvc.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "New Project";
    var clients = ViewBag.Clients as List<App.DAL.Entities.Client> ?? new();
}

<div class="mb-4">
    <a asp-action="Index" class="text-xs text-secondary-ff text-decoration-none">
        <i class="bi bi-arrow-left me-1"></i> Back to Projects
    </a>
    <h1 class="page-title fs-4 fw-bold text-dark mt-2 mb-1">Create Project</h1>
    <p class="page-subtitle text-secondary-ff text-sm mb-0">Set up scope, milestones timeline, and budget allocations</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="ff-card p-4 p-md-5 bg-white shadow-sm rounded-3">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 text-sm mb-4">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="ClientID" class="form-label text-sm fw-medium text-dark"></label>
                    <select asp-for="ClientID" class="form-select" required>
                        <option value="">-- Choose a Client --</option>
                        @foreach (var c in clients)
                        {
                            <option value="@c.ID" selected="@(Model.ClientID == c.ID)">@c.CompanyName</option>
                        }
                    </select>
                    <span asp-validation-for="ClientID" class="text-danger text-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-sm fw-medium text-dark">Project Title</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Website Redesign & Branding" required autofocus />
                    <span asp-validation-for="Name" class="text-danger text-xs"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-sm fw-medium text-dark">Description / Scope</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Summary of project goals and deliverables"></textarea>
                    <span asp-validation-for="Description" class="text-danger text-xs"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label text-sm fw-medium text-dark"></label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger text-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Deadline" class="form-label text-sm fw-medium text-dark"></label>
                        <input asp-for="Deadline" type="date" class="form-control" required />
                        <span asp-validation-for="Deadline" class="text-danger text-xs"></span>
                        <div class="form-text text-xs text-muted-ff">Must be strictly after Start Date (BR-01)</div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Budget" class="form-label text-sm fw-medium text-dark"></label>
                        <input asp-for="Budget" type="number" step="0.01" class="form-control" placeholder="5000.00" required />
                        <span asp-validation-for="Budget" class="text-danger text-xs"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Currency" class="form-label text-sm fw-medium text-dark"></label>
                        <select asp-for="Currency" class="form-select" asp-items="Html.GetEnumSelectList<Currency>()"></select>
                        <span asp-validation-for="Currency" class="text-danger text-xs"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-ff">Cancel</a>
                    <button type="submit" class="btn btn-primary-ff"><i class="bi bi-check2 me-1"></i> Create Project</button>
                </div>
            </form>
        </div>
    </div>
</div>
