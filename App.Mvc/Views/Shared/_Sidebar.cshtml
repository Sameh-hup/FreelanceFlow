@using Microsoft.AspNetCore.Identity
@using App.DAL.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var role = user?.Role.ToString() ?? "Freelancer";
}

<div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)" aria-hidden="true"></div>

<aside class="app-sidebar" id="appSidebar">
    <!-- Brand -->
    <div class="sidebar-brand">
        <div class="sidebar-brand-logo">
            <i class="bi bi-stack"></i>
        </div>
        <div>
            <h2 class="sidebar-brand-title">FreelanceFlow</h2>
            <span class="text-muted-ff text-xs fw-medium">SaaS Platform</span>
        </div>
        <button type="button" class="btn btn-sm btn-ghost-ff d-lg-none ms-auto p-1" onclick="toggleSidebar(false)" aria-label="Close menu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Role Tag -->
    <div class="px-3 pt-3 pb-1">
        <div class="d-flex align-items-center justify-content-between px-2 py-1 bg-light rounded-2">
            <span class="text-xs text-muted-ff text-uppercase fw-semibold">Space</span>
            @if (User.IsInRole("Admin"))
            {
                <span class="badge-ff badge-warning badge-sm">Admin</span>
            }
            else if (User.IsInRole("Client"))
            {
                <span class="badge-ff badge-success badge-sm">Client</span>
            }
            else
            {
                <span class="badge-ff badge-indigo badge-sm">Freelancer</span>
            }
        </div>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">
        <div class="nav-section-title">Navigation</div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="sidebar-nav-item @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
            <a asp-controller="Admin" asp-action="Users" class="sidebar-nav-item @(currentController == "Admin" && currentAction == "Users" ? "active" : "")">
                <i class="bi bi-person-gear"></i>
                <span>Users Management</span>
            </a>
        }
        else if (User.IsInRole("Client"))
        {
            <a asp-controller="Portal" asp-action="Index" class="sidebar-nav-item @(currentController == "Portal" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i>
                <span>Overview</span>
            </a>
            <a asp-controller="Portal" asp-action="Projects" class="sidebar-nav-item @(currentController == "Portal" && currentAction == "Projects" ? "active" : "")">
                <i class="bi bi-kanban"></i>
                <span>My Projects</span>
            </a>
            <a asp-controller="Portal" asp-action="Invoices" class="sidebar-nav-item @(currentController == "Portal" && currentAction == "Invoices" ? "active" : "")">
                <i class="bi bi-receipt"></i>
                <span>My Invoices</span>
            </a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="sidebar-nav-item @(currentController == "Home" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </a>
            <a asp-controller="Clients" asp-action="Index" class="sidebar-nav-item @(currentController == "Clients" ? "active" : "")">
                <i class="bi bi-people"></i>
                <span>Clients</span>
            </a>
            <a asp-controller="Projects" asp-action="Index" class="sidebar-nav-item @(currentController == "Projects" ? "active" : "")">
                <i class="bi bi-kanban"></i>
                <span>Projects</span>
            </a>
            <a asp-controller="Invoices" asp-action="Index" class="sidebar-nav-item @(currentController == "Invoices" ? "active" : "")">
                <i class="bi bi-receipt"></i>
                <span>Invoices</span>
            </a>
        }
    </nav>

    <!-- User Profile & Logout -->
    @if (user != null)
    {
        <div class="sidebar-user">
            <div class="avatar-ff avatar-md avatar-indigo">
                @user.FullName.Substring(0, Math.Min(2, user.FullName.Length)).ToUpper()
            </div>
            <div class="flex-grow-1 overflow-hidden">
                <div class="fw-semibold text-truncate text-sm text-dark">@user.FullName</div>
                <div class="text-muted-ff text-truncate text-xs">@user.Email</div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-ghost-ff p-1 text-muted-ff hover-danger" title="Log out">
                    <i class="bi bi-box-arrow-right fs-5"></i>
                </button>
            </form>
        </div>
    }
</aside>
