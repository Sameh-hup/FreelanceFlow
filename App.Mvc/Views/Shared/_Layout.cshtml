@using Microsoft.AspNetCore.Identity
@using App.DAL.Entities
@inject SignInManager<User> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreelanceFlow</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme Styles from Design -->
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-v2.css" asp-append-version="true" />
    <!-- Immediate Theme Initialization Script (Prevents flash of light mode) -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('ff_theme');
                const systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                const theme = savedTheme || (systemDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {}
        })();
    </script>
</head>
<body>
    @if (SignInManager.IsSignedIn(User) && ViewData["HideSidebar"] == null)
    {
        <div class="app-container">
            <partial name="_Sidebar" />
            <div class="main-wrapper">
                <partial name="_Topbar" />
                <main class="main-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="toast-ff toast-success mb-4 show d-flex align-items-center justify-content-between p-3 rounded-3 shadow-sm bg-success-subtle text-success border border-success-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill fs-5"></i>
                                <span>@TempData["SuccessMessage"]</span>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" onclick="this.parentElement.remove()"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="toast-ff toast-danger mb-4 show d-flex align-items-center justify-content-between p-3 rounded-3 shadow-sm bg-danger-subtle text-danger border border-danger-subtle">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <span>@TempData["ErrorMessage"]</span>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" onclick="this.parentElement.remove()"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @if (ViewContext.RouteData.Values["action"]?.ToString() != "Landing" && (ViewData["Title"]?.ToString()?.StartsWith("FreelanceFlow - The Premier") != true))
        {
            <!-- Floating Theme Toggle for Auth Pages -->
            <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
                <button type="button" class="btn btn-sm btn-ghost-ff p-2 rounded-circle shadow-sm border theme-toggle-btn" onclick="toggleTheme()" title="Toggle Dark/Light Mode" aria-label="Toggle theme" style="background-color: var(--color-surface);">
                    <i class="bi bi-moon-stars-fill fs-5 theme-toggle-icon"></i>
                </button>
            </div>
        }
        <main>
            @RenderBody()
        </main>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar(open) {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (open) {
                sidebar?.classList.add('show');
                backdrop?.classList.add('show');
            } else {
                sidebar?.classList.remove('show');
                backdrop?.classList.remove('show');
            }
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            document.documentElement.setAttribute('data-theme', newTheme);
            try {
                localStorage.setItem('ff_theme', newTheme);
            } catch (e) {}
            syncThemeIcons(newTheme);
        }

        function syncThemeIcons(theme) {
            const icons = document.querySelectorAll('.theme-toggle-icon');
            icons.forEach(icon => {
                if (theme === 'dark') {
                    icon.className = 'bi bi-sun-fill fs-5 theme-toggle-icon text-warning';
                } else {
                    icon.className = 'bi bi-moon-stars-fill fs-5 theme-toggle-icon';
                }
            });
        }

        // Initialize icons on page load
        document.addEventListener('DOMContentLoaded', function() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
            syncThemeIcons(currentTheme);
        });
    </script>
    <script src="~/js/theme-v2.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
